# Vite only exposes env vars prefixed with VITE_
# REST API base (Express routes are mounted under /api)
# Optional: leave unset to use same-origin `/api` (recommended for ngrok/mobile via Vite proxy)
# VITE_API_BASE_URL=http://localhost:5000/api

# Optional: base server URL for Socket.IO + serving uploaded images (/uploads/...)
# If omitted, the app derives it from VITE_API_BASE_URL by stripping /api
# VITE_SERVER_BASE_URL=http://localhost:5000
